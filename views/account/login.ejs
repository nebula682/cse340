

<main class="login-container">
  <h1><%= title %></h1>

  <% if (typeof message != "undefined") { %>
    <div class="flash-message"><%= message %></div>
  <% } %>

  <form action="/account/login" method="post" class="auth-form">
    
    <label for="email">Email:</label>
    <input type="email" id="email" name="account_email" required>
      

       

    <label for="password">Password:</label>
     


       <input type="password" name="account_password" id="accountPassword" required placeholder="Enter your password" />
    

    


    <button type="submit">Login</button>
  </form>

  <p class="form-footer">
    Don’t have an account? <a href="/account/register">Create one</a>
  </p>
</main>














